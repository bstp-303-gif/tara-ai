# Copy this file to .env and fill in real values. Never commit .env itself.

# Django core settings.
# Leave DJANGO_DEBUG unset (or False) in production. Set to True for local dev.
DJANGO_DEBUG=True
# Comma-separated hostnames. Must include your real domain(s) in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Optional: override the SQLite file location (used by docker-compose.yml to
# point at a mounted volume instead of the container's writable layer).
# DJANGO_DB_PATH=/app/data/db.sqlite3

# SMTP settings for sending real emails (Gmail example).
# Leave GPGD_EMAIL_HOST / GPGD_EMAIL_USER blank to fall back to the console
# email backend (emails print to the terminal instead of sending).
GPGD_EMAIL_HOST=
GPGD_EMAIL_PORT=587
GPGD_EMAIL_USE_TLS=true
GPGD_EMAIL_USE_SSL=false
GPGD_EMAIL_USER=
GPGD_EMAIL_PASSWORD=
GPGD_EMAIL_FROM=

# Base URL used to build links inside emails (e.g. invitation links).
GPGD_SITE_URL=http://localhost:8000

# Anthropic API key — powers the autonomous pipeline agent (Agent1 dashboard).
# Get one at https://console.anthropic.com/. Leave blank to keep the pipeline
# on manual buttons only.
ANTHROPIC_API_KEY=
